# ══════════════════════════════════════════════════════════════
# AgentKnowledgeHub 环境配置模板
# 复制为 .env 后填写。切勿把填好的 .env 提交到版本库。
# ══════════════════════════════════════════════════════════════

# ── LLM（必填）───────────────────────────────────────────────
# 任意 OpenAI 兼容接口：DeepSeek / 智谱 / 通义 / 硅基流动 / 本地 Ollama
# 各服务商的具体填法见 docs/llm-config-guide.md
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Embedding（换模型后必须重建向量库）───────────────────────
EMBEDDING_MODEL=text-embedding-3-small
# 留空则复用 OPENAI_API_KEY / OPENAI_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=60

# ── 检索 ─────────────────────────────────────────────────────
# bm25（实测最好）| dense | hybrid
RETRIEVAL_MODE=bm25
# cross-encoder 精排；不可用时自动回退 BM25 原序
RERANK_ENABLED=true
RERANK_CANDIDATES=20

# ── 向量库 ───────────────────────────────────────────────────
# 注意：填错会直接导致启动失败（而非静默走错分支）
VECTOR_STORE_TYPE=chroma

# Chroma 运行模式（关键）
#   persistent = 嵌入式本地文件模式，**无需 Docker**，数据存 CHROMA_PATH
#   http       = 连接独立 Chroma 服务端（需要 Docker 或远程实例）
CHROMA_MODE=persistent
CHROMA_PATH=./chroma_data
# 仅当 CHROMA_MODE=http 时生效
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── 问答 ─────────────────────────────────────────────────────
# pipeline（默认）| react（实测更慢且无质量收益，见 README）
QA_MODE=pipeline
QA_MAX_STEPS=4
# 生成 Prompt 结构：stable（默认）| legacy（仅供 A/B 对照）
ANSWER_PROMPT_MODE=stable

# ── 对话历史（展示保留，不注入 prompt）───────────────────────
QA_HISTORY_RETENTION_DAYS=30
QA_HISTORY_PURGE_INTERVAL_HOURS=6

# ── 持久化与后台任务 ─────────────────────────────────────────
# SQLite：文档状态机 / Outbox / 对话历史 / 用量指标 / 审计
SQLITE_PATH=./data/agenthub.db
# 后台 worker 消费入库任务（关闭后上传的文档不会被处理）
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=2.0
MAX_RETRIES=3

# ── 检索精排（补充项）────────────────────────────────────────
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=30
# 仅 retrieval_mode=hybrid 时生效（实测 hybrid 不如单路 bm25）
HYBRID_BM25_WEIGHT=0.7

# ── 数据级 ACL ───────────────────────────────────────────────
# 文档默认可见范围；Key 的 scope 映射见 api/security.py
DEFAULT_ACL_SCOPE=public

# ── API ──────────────────────────────────────────────────────
# 默认只绑本机；容器内需设为 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8080
# 热重载：开发可开，生产务必 false（reload 会导致半初始化的向量库）
API_RELOAD=false

# ── 认证与限流 ───────────────────────────────────────────────
# 逗号分隔的多个 Key。普通 Key 可访问问答/上传，管理员 Key 才能访问 /api/admin/*
API_KEYS=dev-key-1,dev-key-2
ADMIN_API_KEYS=dev-admin-key-1
RATE_LIMIT_PER_MINUTE=60
# 本地开发可设为 false 关闭鉴权；生产必须为 true
AUTH_ENABLED=true

# ── 上传限制 ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

# ── 运行环境 ─────────────────────────────────────────────────
# dev: 宽容启动（允许弱默认值、依赖失败时降级）
# prod: 严格 fail-fast（弱凭据 / 依赖不可用 / 未配鉴权 都会拒绝启动）
ENVIRONMENT=dev
LOG_LEVEL=INFO
# text 便于本地阅读；json 便于日志采集（ELK/Loki）
LOG_FORMAT=text
